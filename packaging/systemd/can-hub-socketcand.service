[Unit]
Description=can-hub socketcand bridge (exposes hub interfaces as a local socketcand server)
Documentation=https://github.com/can-hub-io/can-hub
After=can-hub.service
Wants=can-hub.service

[Service]
Type=simple
User=can-hub
Group=can-hub
Environment=HUB_URL=unix:///run/can-hub/hub.sock
Environment=SOCKETCAND_ARGS=
EnvironmentFile=-/etc/can-hub/socketcand.conf
ExecStart=/usr/bin/can-hub-client --connect ${HUB_URL} --state-dir /var/lib/can-hub-client socketcand $SOCKETCAND_ARGS
Restart=on-failure
RestartSec=2
StateDirectory=can-hub-client

# Bridges the hub (local unix socket, or a remote hub over quic/tls) to a local
# socketcand TCP server + UDP beacon. Its TLS identity and known_hubs live in
# its own state directory, apart from the hub's. No CAN access: frames travel
# through the hub, so no capabilities.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes

[Install]
WantedBy=multi-user.target
