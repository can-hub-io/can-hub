#compdef can-hub-client

_can_hub_client_connect()
{
    local i
    for ((i = 2; i < $#words; i++)); do
        if [[ ${words[i]} == "--connect" ]]; then
            print -- "${words[i + 1]}"
            return
        fi
    done
}

_can_hub_client_interfaces()
{
    local connect
    connect=$(_can_hub_client_connect)
    if [[ -n $connect ]]; then
        can-hub-client --connect "$connect" --complete interfaces 2>/dev/null
    else
        can-hub-client --complete interfaces 2>/dev/null
    fi
}

_can_hub_setting_words()
{
    case $1 in
        fd | listen-only | loopback | one-shot | triple-sampling | berr-reporting) _values 'state' 'on' 'off' ;;
        bitrate | dbitrate | sample-point | dsample-point | restart-ms | txqueuelen | termination | tq | prop-seg | phase-seg1 | phase-seg2 | sjw | dtq | dprop-seg | dphase-seg1 | dphase-seg2 | dsjw) _message 'value' ;;
        *) _values 'setting' bitrate sample-point dbitrate dsample-point fd listen-only loopback one-shot triple-sampling berr-reporting restart-ms txqueuelen termination tq prop-seg phase-seg1 phase-seg2 sjw dtq dprop-seg dphase-seg1 dphase-seg2 dsjw up down ;;
    esac
}

_can-hub-client()
{
    local -a commands flags values
    local verb verb_index i

    commands=(list dump send attach socketcand show configure txn)
    flags=(
        '--connect[hub URL: quic/tls/tcp/unix]:url:'
        '--state-dir[identity and pin store directory]:dir:_files -/'
        '--hub-fingerprint[trust this hub fingerprint only]:fingerprint:'
        '--no-echo[suppress own echo on dump]'
        '--no-beacon[disable socketcand beacon]'
        '--listen[socketcand bind address]:addr:'
        '--show-identity[print this client TLS fingerprint]'
    )

    for ((i = 2; i < CURRENT; i++)); do
        case ${words[i]} in
            --connect | --state-dir | --hub-fingerprint | --listen) ((i++)) ;;
            -*) ;;
            *) verb=${words[i]}; verb_index=i; break ;;
        esac
    done

    if [[ -z $verb ]]; then
        if [[ ${words[CURRENT]} == --* ]]; then
            _arguments $flags
        else
            _describe 'command' commands
            _arguments $flags
        fi
        return
    fi

    case $verb in
        dump | send | attach | show | configure | txn)
            if (( CURRENT == verb_index + 1 )); then
                values=(${(f)"$(_can_hub_client_interfaces)"})
                _describe 'interface' values
            elif [[ $verb == txn ]] && (( CURRENT == verb_index + 2 )); then
                _files -g '*.txn'
            elif [[ $verb == attach ]] && (( CURRENT == verb_index + 2 )); then
                _net_interfaces
            elif [[ $verb == configure ]]; then
                _can_hub_setting_words "${words[CURRENT - 1]}"
            fi
            ;;
    esac
}

_can-hub-client "$@"
