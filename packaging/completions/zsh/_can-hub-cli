#compdef can-hub-cli

_can_hub_cli_connect()
{
    local i
    for ((i = 2; i < $#words; i++)); do
        if [[ ${words[i]} == "--connect" ]]; then
            print -- "${words[i + 1]}"
            return
        fi
    done
}

_can_hub_cli_dynamic()
{
    local connect
    connect=$(_can_hub_cli_connect)
    if [[ -n $connect ]]; then
        can-hub-cli --connect "$connect" --complete "$1" 2>/dev/null
    else
        can-hub-cli --complete "$1" 2>/dev/null
    fi
}

_can_hub_setting_words()
{
    case $1 in
        fd | listen-only | loopback | one-shot | triple-sampling | berr-reporting) _values 'state' 'on' 'off' ;;
        bitrate | dbitrate | sample-point | dsample-point | restart-ms | txqueuelen | termination | tq | prop-seg | phase-seg1 | phase-seg2 | sjw | dtq | dprop-seg | dphase-seg1 | dphase-seg2 | dsjw) _message 'value' ;;
        *) _values 'setting' bitrate sample-point dbitrate dsample-point fd listen-only loopback one-shot triple-sampling berr-reporting restart-ms txqueuelen termination tq prop-seg phase-seg1 phase-seg2 sjw dtq dprop-seg dphase-seg1 dphase-seg2 dsjw up down ;;
    esac
}

_can-hub-cli()
{
    local -a commands values
    local verb sub verb_index i

    commands=(status peers agents clients interfaces pins acl pending interface bridge group)

    for ((i = 2; i < CURRENT; i++)); do
        case ${words[i]} in
            --connect) ((i++)) ;;
            -*) ;;
            *) verb=${words[i]}; verb_index=i; break ;;
        esac
    done

    if [[ -z $verb ]]; then
        if [[ ${words[CURRENT]} == --* ]]; then
            _values 'flag' '--connect[hub admin socket URL]'
        else
            _describe 'command' commands
        fi
        return
    fi

    sub=${words[verb_index + 1]}
    case $verb in
        peers)
            if (( CURRENT == verb_index + 1 )); then
                _values 'subcommand' 'kick'
            elif [[ $sub == kick ]]; then
                values=(${(f)"$(_can_hub_cli_dynamic peers)"})
                _describe 'peer-id' values
            fi
            ;;
        agents)
            if (( CURRENT == verb_index + 1 )); then
                _values 'subcommand' 'show' 'kick'
            elif [[ $sub == show || $sub == kick ]]; then
                values=(${(f)"$(_can_hub_cli_dynamic agents)"})
                _describe 'agent' values
            fi
            ;;
        pins)
            if (( CURRENT == verb_index + 1 )); then
                _values 'subcommand' 'add' 'delete'
            elif [[ $sub == delete ]]; then
                values=(${(f)"$(_can_hub_cli_dynamic agents)"})
                _describe 'agent' values
            fi
            ;;
        acl)
            if (( CURRENT == verb_index + 1 )); then
                _values 'subcommand' 'add' 'delete' 'list'
            elif [[ $sub == add || $sub == delete ]] && (( CURRENT == verb_index + 3 )); then
                values=('*' ${(f)"$(_can_hub_cli_dynamic interfaces)"})
                _describe 'interface' values
            elif [[ $sub == add ]] && (( CURRENT == verb_index + 4 )); then
                _values 'level' 'none' 'r' 'rw' 'rwa'
            fi
            ;;
        bridge)
            if (( CURRENT == verb_index + 1 )); then
                _values 'subcommand' 'add' 'delete'
            elif (( CURRENT == verb_index + 2 || CURRENT == verb_index + 3 )); then
                values=(${(f)"$(_can_hub_cli_dynamic interfaces)"})
                _describe 'interface' values
            fi
            ;;
        group)
            if (( CURRENT == verb_index + 1 )); then
                _values 'subcommand' 'add' 'delete' 'join' 'leave'
            elif [[ $sub == join || $sub == leave ]] && (( CURRENT == verb_index + 3 )); then
                values=(${(f)"$(_can_hub_cli_dynamic interfaces)"})
                _describe 'interface' values
            fi
            ;;
        interface)
            if (( CURRENT == verb_index + 1 )); then
                _values 'subcommand' 'show' 'set' 'up' 'down'
            elif (( CURRENT == verb_index + 2 )); then
                values=(${(f)"$(_can_hub_cli_dynamic interfaces)"})
                _describe 'interface' values
            elif [[ $sub == set ]] && (( CURRENT >= verb_index + 3 )); then
                _can_hub_setting_words "${words[CURRENT - 1]}"
            fi
            ;;
    esac
}

_can-hub-cli "$@"
