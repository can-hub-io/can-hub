# bash completion for can-hub-client

_can_hub_client_connect()
{
    local i
    for ((i = 1; i < ${#COMP_WORDS[@]} - 1; i++)); do
        if [[ ${COMP_WORDS[i]} == "--connect" ]]; then
            printf '%s' "${COMP_WORDS[i + 1]}"
            return
        fi
    done
}

_can_hub_client_interfaces()
{
    local connect
    connect=$(_can_hub_client_connect)
    if [[ -n $connect ]]; then
        can-hub-client --connect "$connect" --complete interfaces 2>/dev/null
    else
        can-hub-client --complete interfaces 2>/dev/null
    fi
}

_can_hub_setting_words()
{
    case $1 in
        fd | listen-only | loopback | one-shot | triple-sampling | berr-reporting) echo "on off" ;;
        bitrate | dbitrate | sample-point | dsample-point | restart-ms | txqueuelen | termination | tq | prop-seg | phase-seg1 | phase-seg2 | sjw | dtq | dprop-seg | dphase-seg1 | dphase-seg2 | dsjw) ;;
        *) echo "bitrate sample-point dbitrate dsample-point fd listen-only loopback one-shot triple-sampling berr-reporting restart-ms txqueuelen termination tq prop-seg phase-seg1 phase-seg2 sjw dtq dprop-seg dphase-seg1 dphase-seg2 dsjw up down" ;;
    esac
}

_can_hub_client()
{
    local cur prev words cword
    _init_completion || return

    local commands="list dump send attach socketcand show configure"
    local flags="--connect --state-dir --no-echo --no-beacon --listen --show-identity"

    case $prev in
        --connect | --state-dir | --listen)
            return
            ;;
    esac
    if [[ $cur == --* ]]; then
        COMPREPLY=($(compgen -W "$flags" -- "$cur"))
        return
    fi

    local verb="" i verb_index=0
    for ((i = 1; i < cword; i++)); do
        case ${words[i]} in
            --connect | --state-dir | --listen) ((i++)) ;;
            -*) ;;
            *) verb=${words[i]}; verb_index=i; break ;;
        esac
    done

    if [[ -z $verb ]]; then
        COMPREPLY=($(compgen -W "$commands $flags" -- "$cur"))
        return
    fi

    case $verb in
        dump | send | attach | show | configure)
            if (( cword == verb_index + 1 )); then
                COMPREPLY=($(compgen -W "$(_can_hub_client_interfaces)" -- "$cur"))
            elif [[ $verb == "attach" ]] && (( cword == verb_index + 2 )); then
                _available_interfaces 2>/dev/null
            elif [[ $verb == "configure" ]]; then
                COMPREPLY=($(compgen -W "$(_can_hub_setting_words "$prev")" -- "$cur"))
            fi
            ;;
    esac
}

complete -F _can_hub_client can-hub-client
